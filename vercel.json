{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "frontend",
  "functions": {"api/index.ts": {"maxDuration": 30}},
  "rewrites": [
    {"source": "/api/:route*", "destination": "/api/index?route=:route*"},
    {"source": "/assets/:asset*", "destination": "/:asset*"},
    {"source": "/review/:id", "destination": "/review.html"},
    {"source": "/dashboard", "destination": "/index.html"},
    {"source": "/about", "destination": "/index.html"},
    {"source": "/insights", "destination": "/index.html"},
    {"source": "/how-it-works", "destination": "/index.html"},
    {"source": "/approve/:id*", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source": "/review/:id", "headers": [{"key":"Cache-Control","value":"private, no-store"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"}]}
  ]
}
