# Node 24+. Local demo works with no secrets.
PORT=3000
APP_TOKEN=replace-with-a-long-random-secret
DB_PATH=data/agent.sqlite
# Both required for Supabase mode; otherwise SQLite is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Single-user Google OAuth offline credentials (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional Cloud Vision OAuth access token + billing project for image OCR.
VISION_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
# macOS Photon bridge: exact participant address, only this sender is accepted.
PHOTON_PARTICIPANT=
AGENT_URL=http://127.0.0.1:3000
