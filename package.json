{
  "name": "my-project",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "web": "bun src/web-server.ts",
    "backend": "python3 -m backend.main",
    "photon": "node --experimental-transform-types --env-file-if-exists=.env bridge/photon.mjs",
    "test": "python3 -m unittest test_backend.py",
    "start:node": "node --experimental-transform-types --env-file-if-exists=.env src/index.ts",
    "test:bot": "bun test tests",
    "web:node": "node --experimental-transform-types --env-file-if-exists=.env src/web-server.ts",
    "build:hosted": "bun scripts/build-hosted-api.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@photon-ai/advanced-imessage": "2.3.0",
    "@photon-ai/imessage-kit": "3.0.0",
    "@spectrum-ts/imessage": "^12.11.0",
    "googleapis": "^186.0.0",
    "heic-convert": "^2.1.0",
    "spectrum-ts": "^12.11.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/bun": "latest"
  }
}
